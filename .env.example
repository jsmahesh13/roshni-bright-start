# Copy this file to .env and fill in your own Supabase project's values.
# Both the plain and VITE_-prefixed names are needed: the VITE_ ones are
# inlined into the client bundle, the plain ones are read server-side
# (see src/integrations/supabase/client.ts and auth-middleware.ts).

SUPABASE_PROJECT_ID="<your-project-id>"
SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<your-project-id>"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
VITE_SUPABASE_URL="https://<your-project>.supabase.co"

# Required for voice transcription and AI-assisted noticing structuring —
# see src/lib/transcribe.functions.ts and src/lib/structure.functions.ts.
LOVABLE_API_KEY="<your-lovable-ai-gateway-key>"
